# Copy to .env.local and fill in once real accounts exist. Every one of these is optional —
# with all of them unset, the site runs entirely in mock mode (fake invoices, auto-confirmed
# payments, fake eSIM activation codes) so the full flow can be built/demoed without any real
# credentials. See CLAUDE.md for what mock mode does at each integration point.

# Blink (blink.sv) Lightning wallet — Dashboard > API Keys
BLINK_API_KEY=
BLINK_WALLET_ID=
# BLINK_API_URL=https://api.staging.blink.sv/graphql   # uncomment to use Blink's staging network

# Blink webhook signature verification (src/app/api/webhooks/blink/route.ts) — from the Blink
# Dashboard's Callback Endpoints page, issued when you register this endpoint's public URL.
# Needs a real public URL to register against, so this can't be set up until deployed somewhere
# reachable from the internet — not for local dev. Required before pointing a real Blink account
# at a public deployment; without it the webhook route has no way to confirm a payload is
# genuinely from Blink and not forged.
BLINK_WEBHOOK_SECRET=

# Maya Mobile Connect+ — issued on partner onboarding (NDA'd docs, see src/lib/maya.ts)
MAYA_API_KEY=
# MAYA_API_URL=https://api.maya.net/connect

# Order storage — leave unset for local dev (SQLite, zero-setup, see src/lib/db/sqlite.ts). Set
# this in production to switch to Postgres (src/lib/db/postgres.ts) — Vercel's Neon integration
# (Project Settings > Storage > add Postgres) injects this automatically, no separate Neon account
# needed. Do not set this for local dev unless you specifically want to test against Postgres.
DATABASE_URL=
