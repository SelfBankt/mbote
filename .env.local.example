# Copy to .env.local and fill in once real accounts exist. Every one of these is optional —
# with all of them unset, the site runs entirely in mock mode (fake invoices, auto-confirmed
# payments, fake eSIM activation codes) so the full flow can be built/demoed without any real
# credentials. See CLAUDE.md for what mock mode does at each integration point.

# Blink (blink.sv) Lightning wallet — Dashboard > API Keys
BLINK_API_KEY=
BLINK_WALLET_ID=
# BLINK_API_URL=https://api.staging.blink.sv/graphql   # uncomment to use Blink's staging network

# Maya Mobile Connect+ — issued on partner onboarding (NDA'd docs, see src/lib/maya.ts)
MAYA_API_KEY=
# MAYA_API_URL=https://api.maya.net/connect
